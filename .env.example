# Copy to .env and edit. `docker compose` reads .env automatically, and .env
# itself is gitignored, so the values set here never reach the repository.

# Host port to publish the site on. The container always listens on 80.
HOST_PORT=8080

# Registry used during the image build. Leave it empty to keep the default from
# the repository's .npmrc (registry.npmmirror.com), which is the fast path from
# inside China. Set it when building elsewhere, for example:
# NPM_REGISTRY=https://registry.npmjs.org/
NPM_REGISTRY=

# Base path the bundle is built for. `/` serves from the site root; a sub-path
# such as /zip-in-image/ rewrites the asset URLs in index.html to match. Changing
# this needs a rebuild, not just a restart.
VITE_BASE_PATH=/
