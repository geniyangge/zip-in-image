node_modules/
dist/
.tmp/
coverage/
.vite/
.ulw/
.omo/
.tmp/
*.local
*.log
.DS_Store

# Lockfiles. This project is on pnpm, so `pnpm-lock.yaml` IS committed (it is the
# reproducibility contract). The other package managers' lockfiles are ignored so a
# stray `npm install` / `yarn` run cannot quietly become the source of truth.
package-lock.json
yarn.lock
bun.lockb
.npmrc.local

# pnpm's content-addressable store lives outside the project by default, but keep this
# in case a future `node-linker` change moves it in
.pnpm-store/

# Local compose overrides. `.env.example` is the tracked template; `.env` is
# per-machine and holds HOST_PORT, NPM_REGISTRY and VITE_BASE_PATH, none of which
# belong in the repository. Not adding `.env.local` and friends: compose reads
# `.env` only, so an untracked variant would be silently ignored.
.env
